# Hugluno Snapshot — Caddy（自动 https，最省事）。把 hugluno-snapshot-web 解压到 /srv/hugluno 后：
#   caddy run --config deploy/Caddyfile
hugluno.example.com {            # ← 改成你的域名
	root * /srv/hugluno
	file_server
	encode zstd gzip
	log { output discard }         # 不记访问日志
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}
	@fonts path /fonts/*
	header @fonts Access-Control-Allow-Origin "*"
	# 想加密码：basic_auth { 用户名 <caddy hash-password 的结果> }
}

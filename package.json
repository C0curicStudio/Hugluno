{
  "name": "hugluno-snapshot",
  "productName": "Hugluno Snapshot",
  "version": "1.1.0",
  "description": "Hugluno open-source snapshot — fully local, no account, no subscription, no proxy. 开源快照版 · Édition snapshot open source.",
  "author": "C0curic Studio",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/C0curicStudio/Hugluno",
  "repository": { "type": "git", "url": "git+https://github.com/C0curicStudio/Hugluno.git" },
  "private": false,
  "main": "desktop/main.js",
  "scripts": {
    "start": "node tools/serve.mjs",
    "desktop": "electron .",
    "test": "node --test tests/*.test.mjs",
    "e2e": "node tests/e2e.mjs",
    "audit": "node tools/audit.mjs",
    "pack:web": "node tools/pack-web.mjs",
    "lock-csp": "node tools/lock-csp.mjs",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg --universal --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "top.c0curic.hugluno.snapshot",
    "productName": "Hugluno Snapshot",
    "files": ["desktop/**", "app/**", "package.json", "LICENSE", "COPYRIGHT.md", "THIRD_PARTY_LICENSES.md"],
    "directories": { "buildResources": "desktop/build", "output": "dist" },
    "win": { "target": "nsis", "icon": "desktop/build/icon.ico", "artifactName": "Hugluno-Snapshot-Setup-${version}.${ext}" },
    "nsis": {
      "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true, "shortcutName": "Hugluno Snapshot",
      "installerIcon": "desktop/build/icon.ico", "uninstallerIcon": "desktop/build/icon.ico",
      "installerSidebar": "desktop/build/installerSidebar.bmp", "uninstallerSidebar": "desktop/build/uninstallerSidebar.bmp", "installerHeader": "desktop/build/installerHeader.bmp",
      "multiLanguageInstaller": true, "installerLanguages": ["zh_CN", "en_US", "fr_FR"]
    },
    "mac": { "target": "dmg", "icon": "desktop/icon.png", "category": "public.app-category.productivity", "artifactName": "Hugluno-Snapshot-${version}-universal.${ext}", "identity": "-", "hardenedRuntime": false, "darkModeSupport": true, "minimumSystemVersion": "11.0" },
    "dmg": { "title": "Hugluno Snapshot", "iconSize": 110, "window": { "width": 540, "height": 380 }, "background": "desktop/build/background.png",
      "contents": [{ "x": 140, "y": 190, "type": "file" }, { "x": 400, "y": 190, "type": "link", "path": "/Applications" }] }
  }
}
